class Solution {
    public int subarraySum(int[] nums, int k) {
        Map<Integer,Integer>mpp = new HashMap<>();
        mpp.put(0,1);
        int count = 0;
        int sum = 0;
        for(int ele : nums){
            sum += ele;
            count += mpp.getOrDefault(sum-k,0);
            mpp.put(sum,mpp.getOrDefault(sum,0)+1);
        }
        return count;
    }
}
