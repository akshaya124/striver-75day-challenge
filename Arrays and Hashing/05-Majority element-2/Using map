class Solution {
    public int longestConsecutive(int[] nums) {
        if(nums.length == 0){
            return 0;
        }
        Arrays.sort(nums);
       int longest = 1;
       int cnt = 1;
       int lastsmaller = Integer.MAX_VALUE;
       for(int i = 0;i<nums.length;i++){
        if(nums[i] - 1 == lastsmaller){
            cnt = cnt+1;
            lastsmaller = nums[i];
        }else if(nums[i] != lastsmaller){
            cnt = 1;
            lastsmaller = nums[i];
        }
       longest = Math.max(longest, cnt);
       }
       return longest;
    }
}
