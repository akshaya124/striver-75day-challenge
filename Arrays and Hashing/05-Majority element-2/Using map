class Solution {
    public List<Integer> majorityElementTwo(int[] nums) {
        int n = nums.length;
        Map<Integer,Integer>mpp = new HashMap<>();
        for(int ele : nums){
            mpp.put(ele,mpp.getOrDefault(ele,0)+1);
        }
        List<Integer> ans = new ArrayList<>();
        for(int ele : mpp.keySet()){
            if(mpp.get(ele)> n/3){
                ans.add(ele);
            }
        }
        return ans;
    }
}
